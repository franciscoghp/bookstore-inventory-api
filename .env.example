# TODAS las variables son obligatorias (la app no arranca si falta alguna).
# Copia este archivo a .env para correr en local.

# Cadena de conexion a Postgres (Neon / Supabase / local con docker-compose)
DATABASE_URL=postgres://bookstore:bookstore@localhost:5432/bookstore
# Puerto del servidor (solo local/Docker; Vercel no lo usa)
PORT=3000
# API de tasas de cambio
EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
# Timeout (ms) de la llamada a la API externa
EXCHANGE_API_TIMEOUT_MS=4000
# Margen de ganancia (%)
PROFIT_MARGIN_PERCENTAGE=40
# Tasa USD->moneda local si la API falla y no hay tasa de respaldo para la moneda
DEFAULT_EXCHANGE_RATE=1
# Segundos que se reutiliza la tasa de cambio guardada en la BD antes de volver a consultar la API
EXCHANGE_RATE_CACHE_TTL_SECONDS=3600
